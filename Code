import numpy as np
from numpy.polynomial.polynomial import Polynomial

def compute_dfa(signal, scale_list):
    profile = np.cumsum(signal - np.mean(signal))
    flucts = []
    for scale in scale_list:
        segments = len(profile) // scale
        local_trends = []
        for i in range(segments):
            segment = profile[i * scale:(i + 1) * scale]
            poly = Polynomial.fit(range(scale), segment, 1)
            detrended = segment - poly(range(scale))
            local_trends.append(np.sqrt(np.mean(detrended**2)))
        flucts.append(np.mean(local_trends))
    return flucts
