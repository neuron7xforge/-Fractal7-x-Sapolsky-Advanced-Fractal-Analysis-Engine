import pywt

def wtmm(signal, wavelet='mexh', scales=np.arange(1, 64)):
    coeffs, _ = pywt.cwt(signal, scales, wavelet)
    modulus = np.abs(coeffs)
    maxima = np.max(modulus, axis=1)
