import numpy as np

def hurst_exponent(ts):
    lags = range(2, 100)
    tau = [np.std(np.subtract(ts[lag:], ts[:-lag])) for lag in lags]
    m, _ = np.polyfit(np.log(lags), np.log(tau), 1)
    return m
