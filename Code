import numpy as np

def singularity_spectrum(ts, q_range):
    spectrum = []
    for q in q_range:
        weights = np.abs(ts)**q
        weights /= np.sum(weights)
        entropy = -np.sum(weights * np.log(weights + 1e-10))
        spectrum.append(entropy)
    return q_range, np.array(spectrum)
